# Auto detect text files and perform LF normalization
* text=auto

# Patch files
*.patch text
*.ts.patch linguist-language=TypeScript
*.json.patch linguist-language=JSON

# Source code
*.ts text diff=typescript
*.js text
*.json text
*.md text diff=markdown

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.vsix binary
